# Copy to .env and adjust. Never commit .env.

# --- api ---
DATABASE_URL="postgresql://loom:loom@localhost:5433/loom?schema=public"
PORT=3001
NODE_ENV=development

# Secret for signing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-your-own-env-file"
AUTH_URL="http://localhost:3001"

# Where the frontend runs, for CORS
WEB_ORIGIN="http://localhost:5173"

# --- web (must be prefixed VITE_ to reach the browser) ---
VITE_API_URL="http://localhost:3001"
