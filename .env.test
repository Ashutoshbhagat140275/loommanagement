# Test-only config. No real secrets here. Committed on purpose so `pnpm test`
# works straight after a clone. The database name must contain "test": the
# test bootstrap refuses to wipe anything else.
DATABASE_URL="postgresql://loom:loom@localhost:5433/loom_test?schema=public"
PORT=3002
NODE_ENV=test
AUTH_SECRET="test-secret-not-used-anywhere-real-0123456789"
AUTH_URL="http://localhost:3002"
WEB_ORIGIN="http://localhost:5173"
