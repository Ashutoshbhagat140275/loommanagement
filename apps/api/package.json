{
  "name": "@loom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/setup-test-db.ts && node --import tsx --env-file=../../.env.test --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@loom/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
