// Phase 1 schema: factories, users, auth, workers.
// Looms and production (phase 2), stock (phase 4) and the ledger (phase 5)
// are added in their own phases so each migration stays reviewable.
//
// Money is never stored here as a decimal. Every amount is an integer number
// of paise in an Int column. See packages/shared/src/money.ts.

// Prisma 7 takes the connection URL from prisma.config.ts (for the CLI) and
// from the driver adapter in src/db/client.ts (at runtime), not from here.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  OWNER
  SUPERVISOR
  WORKER
  SUPER_ADMIN
}

enum WageType {
  PER_SAREE
  PER_INCH
}

enum LoomStatus {
  RUNNING
  STOPPED
  REPAIR
}

enum LoomPlace {
  IN_FACTORY
  AT_WEAVER_HOME
}

enum SareeJobStatus {
  RUNNING
  FINISHED
}

enum ProductionEntryStatus {
  APPROVED
  AWAITING_OWNER
}

enum MaterialUnit {
  KG
  BUNDLE
}

enum StockMovementKind {
  /// Into the store room. Also used for opening stock, with no cost.
  PURCHASE
  GIVEN_TO_SAREE
  RETURNED_FROM_SAREE
  /// Bought by the weaver for a saree and paid back. Never in the store room,
  /// so it does not change stock; it only adds to the saree's cost.
  BOUGHT_BY_WEAVER
}

enum ReimbursementMethod {
  CASH_NOW
  INTO_PASSBOOK
}

/// Once finished, a saree is stock: in the store room, or sold.
enum FinishedSareeStatus {
  IN_STOCK
  SOLD
}

/// A weaver's passbook has two sections that never mix on their own.
enum LedgerSection {
  /// Money for a particular saree: its wage or its inches, and what was paid
  /// against it. One of these per saree the weaver is or was on.
  CURRENT_WORK
  /// Advances, and anything left over from a saree the weaver was shifted
  /// off. One per weaver. Only moves when the owner says so.
  OLD_BALANCE
}

enum LedgerKind {
  WORK_EARNED
  PAYMENT_CASH
  /// The part of a payment made by cutting the weaver's advance. Always
  /// written together with an ADVANCE_CUT in the same group.
  PAYMENT_BY_ADVANCE_CUT
  ADVANCE_GIVEN
  ADVANCE_CUT
  OLD_BALANCE_SETTLED
  /// Takes back the part of a per-saree wage a shifted weaver did not weave.
  SHIFT_ADJUSTMENT
  /// Moves a balance from one section to the other; written in pairs.
  CARRIED_OVER
  MATERIAL_REIMBURSEMENT
}

/// A tenant. Every row that belongs to a factory carries factoryId, and the
/// scoped Prisma client in src/db/tenant.ts refuses to query without it.
model Factory {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  workers    Worker[]
  looms      Loom[]
  sareeTypes SareeType[]
  sareeJobs  SareeJob[]
  materials  Material[]
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String? @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Workers sign in with their phone number as the username and a PIN.
  username        String? @unique
  displayUsername String?

  role Role @default(WORKER)

  /// Null only for SUPER_ADMIN, who sits above every factory.
  factoryId String?
  factory   Factory? @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  worker   Worker?

  @@index([factoryId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hashed password for owners, hashed PIN for workers. Never plain text.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// A weaver. Kept separate from User because the owner adds workers long
/// before (or without) them ever getting a login.
model Worker {
  id String @id @default(cuid())

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  name     String
  phone    String?
  photoUrl String?

  wageType WageType @default(PER_SAREE)

  /// Trusted workers' inch entries are accepted as they are. Everyone else's
  /// entries wait for the owner to check the loom and approve.
  trusted Boolean @default(false)
  active  Boolean @default(true)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs              SareeJobWorker[]
  ledgerLines       LedgerLine[]
  materialPurchases StockMovement[]

  @@unique([factoryId, phone])
  @@index([factoryId])
}

model Loom {
  id String @id @default(cuid())

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  /// What the owner calls it, for example "4" or "A-12".
  number String
  status LoomStatus @default(RUNNING)
  place  LoomPlace  @default(IN_FACTORY)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sareeJobs SareeJob[]

  @@unique([factoryId, number])
  @@index([factoryId])
}

/// A kind of saree the factory weaves, with the usual length and rate. Only a
/// template: the real numbers are copied onto each SareeJob when it starts.
model SareeType {
  id String @id @default(cuid())

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  name         String
  lengthInches Int @default(216)

  /// Whole wage for weaving one, in paise. Used when wageType is PER_SAREE.
  defaultWagePaise Int?
  /// Rate per inch in paise. Used when wageType is PER_INCH.
  defaultRatePerInchPaise Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sareeJobs SareeJob[]

  @@unique([factoryId, name])
  @@index([factoryId])
}

/// One real saree being woven on one loom. The wage numbers are copied here at
/// the start, so changing a SareeType later never rewrites history.
model SareeJob {
  id String @id @default(cuid())

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  loomId String
  loom   Loom   @relation(fields: [loomId], references: [id], onDelete: Restrict)

  sareeTypeId String?
  sareeType   SareeType? @relation(fields: [sareeTypeId], references: [id], onDelete: SetNull)

  label        String?
  lengthInches Int

  wageType WageType

  /// Exactly one of these is set, matching wageType.
  wagePaise        Int?
  ratePerInchPaise Int?

  status     SareeJobStatus @default(RUNNING)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  /// Set when the saree is finished. Null while it is still on the loom.
  saleStatus FinishedSareeStatus?
  soldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers        SareeJobWorker[]
  entries        ProductionEntry[]
  ledgerLines    LedgerLine[]
  stockMovements StockMovement[]

  @@index([factoryId, status])
  @@index([loomId])
}

/// Which weavers are on a saree. Up to two at a time, and the work money is
/// always split half and half between whoever is active.
model SareeJobWorker {
  id String @id @default(cuid())

  factoryId String

  sareeJobId String
  sareeJob   SareeJob @relation(fields: [sareeJobId], references: [id], onDelete: Cascade)

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  active   Boolean   @default(true)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  /// How far the saree had got when this weaver joined. 0 for anyone there
  /// from the start. A replacement's share of the wage covers only the inches
  /// from here to the end, so shifting them later needs this.
  joinedAtInches Int @default(0)

  /// What this weaver had already earned on the saree when their share last
  /// changed. Their share covers joinedAtInches to the end; this is what they
  /// had banked before that point. Only non-zero once a weaver has taken over
  /// someone else's unwoven share part way through.
  earnedBeforeJoinPaise Int @default(0)

  /// How many inches the saree had reached when this weaver was taken off it.
  /// Phase 5 needs this to work out their share: inches / length x wage.
  leftAtInches Int?

  @@unique([sareeJobId, workerId])
  @@index([factoryId])
  @@index([workerId])
}

/// How much was woven on one saree in one week.
///
/// One row per saree per week, not per weaver. Two weavers share a loom and
/// the loom has a single output, so letting each of them file the same 20
/// inches would count the work twice.
model ProductionEntry {
  id String @id @default(cuid())

  factoryId String

  sareeJobId String
  sareeJob   SareeJob @relation(fields: [sareeJobId], references: [id], onDelete: Cascade)

  /// Monday of the week being reported, stored as a plain date.
  weekStart DateTime @db.Date

  /// Inches woven during this week, not the saree's running total.
  inches Int

  /// Id made on the phone before the entry is sent.
  ///
  /// A weaver files from the loom, often with no signal. When the reply is
  /// lost the phone retries, and without this the same week would be filed
  /// twice. Sending the same clientId again returns the entry already stored
  /// instead of making another.
  clientId String?

  /// The rate in force on the day it was entered. Changing the job's rate
  /// later must not rewrite what someone already earned.
  ratePerInchPaise Int?

  status ProductionEntryStatus

  enteredByUserId String
  approvedAt      DateTime?
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sareeJobId, weekStart])
  @@unique([factoryId, clientId])
  @@index([factoryId, status])
}

/// Silk yarn, zari and so on. Each material has one unit: an owner who buys
/// zari both by the bundle and by weight keeps them as two materials.
model Material {
  id String @id @default(cuid())

  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  name String
  unit MaterialUnit

  /// Warn when stock falls to this or below, in thousandths of a unit.
  lowStockAtMilli Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([factoryId, name])
  @@index([factoryId])
}

/// Every time material moves. Like the passbook, these are only ever added:
/// stock on hand is always worked out from them, never stored.
///
/// Quantities are whole thousandths of the material's unit, so 2.5 kg is 2500
/// and 3 bundles is 3000, for the same reason money is in paise: no rounding
/// errors from decimals.
model StockMovement {
  id String @id @default(cuid())

  factoryId String

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  kind StockMovementKind

  /// Always positive; the kind says which way it moved.
  quantityMilli Int

  /// What it cost in total, where known. Null for opening stock recorded
  /// without a price, and for anything given out before a priced purchase.
  costPaise Int?

  supplier String?

  sareeJobId String?
  sareeJob   SareeJob? @relation(fields: [sareeJobId], references: [id], onDelete: Restrict)

  /// The weaver who paid, for BOUGHT_BY_WEAVER.
  workerId      String?
  worker        Worker?              @relation(fields: [workerId], references: [id], onDelete: Restrict)
  reimbursement ReimbursementMethod?

  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([factoryId, materialId])
  @@index([sareeJobId])
}

/// One line in a weaver's passbook. The replacement for the owner's khata.
///
/// Append-only: a mistake is put right with another line, never by editing or
/// deleting one, so the history always adds up to the balance and the owner
/// can see how it got there. No balance is stored anywhere; it is always the
/// sum of these lines.
///
/// Sign: positive means the owner owes the weaver more, negative means less
/// (or, below zero, that the weaver owes the owner).
model LedgerLine {
  id String @id @default(cuid())

  factoryId String

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  section     LedgerSection
  kind        LedgerKind
  amountPaise Int

  /// Set on every CURRENT_WORK line, since that section is kept per saree.
  sareeJobId String?
  sareeJob   SareeJob? @relation(fields: [sareeJobId], references: [id], onDelete: Restrict)

  /// Set on the WORK_EARNED lines an approved per-inch entry produced.
  productionEntryId String?

  /// Lines written by one action share this, such as the cash and the advance
  /// cut of a single payment, so they can be shown and checked as one.
  groupId String

  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  /// An approved entry pays each weaver on it exactly once, however many
  /// times the approval runs.
  @@unique([productionEntryId, workerId])
  @@index([factoryId, workerId])
  @@index([workerId, section])
  @@index([sareeJobId])
  @@index([groupId])
}
